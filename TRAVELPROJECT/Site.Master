<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="TRAVELPROJECT.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Travela Tourism</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet"> 

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-color: #13357B;
            --dark-color: #011233;
        }

        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #f3f6f9;
            margin: 0;
            padding: 0;
        }

        /* Topbar Style */
        .topbar {
            background: var(--primary-color);
            padding: 10px 0;
        }
        .topbar .btn-square {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.4);
            color: #ffffff;
            margin-right: 5px;
            font-size: 13px;
            transition: 0.3s;
        }
        .topbar .btn-square:hover {
            background: #ffffff;
            color: var(--primary-color);
        }
        .topbar-right a {
            color: #ffffff;
            font-size: 14px;
            text-decoration: none;
            margin-left: 18px;
            font-weight: 500;
        }
        .topbar-right a:hover {
            opacity: 0.8;
        }

        /* Navbar Style */
        .navbar-travela {
            background: #ffffff;
            padding: 0 45px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.08);
        }
        .navbar-travela .navbar-brand h1 {
            font-family: 'Jost', sans-serif;
            font-weight: 700;
            font-size: 36px;
            color: var(--primary-color);
            margin: 0;
        }
        .navbar-travela .nav-link {
            font-family: 'Jost', sans-serif;
            padding: 25px 18px !important;
            font-size: 16px;
            font-weight: 600;
            color: #444444 !important;
            transition: 0.3s;
        }
        .navbar-travela .nav-link:hover,
        .navbar-travela .nav-link.active {
            color: var(--primary-color) !important;
        }

        /* Dropdown Style */
        .navbar-travela .dropdown-menu {
            border-radius: 8px;
            border: none;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 10px 0;
        }
        .navbar-travela .dropdown-item {
            font-family: 'Jost', sans-serif;
            font-weight: 500;
            padding: 8px 20px;
            color: #444444;
            transition: 0.3s;
        }
        .navbar-travela .dropdown-item:hover {
            background-color: #f8f9fa;
            color: var(--primary-color);
            padding-left: 25px;
        }

        .btn-book-now {
            background-color: var(--primary-color);
            color: #ffffff !important;
            font-family: 'Jost', sans-serif;
            font-weight: 600;
            padding: 10px 25px;
            border-radius: 30px;
            border: none;
            text-decoration: none;
        }
        .btn-book-now:hover {
            background-color: #0c2352;
        }

        /* Footer Style */
        .footer {
            background: var(--dark-color);
            color: rgba(255, 255, 255, 0.7);
            margin-top: 60px;
        }
        .footer h4, .footer h3 {
            font-family: 'Jost', sans-serif;
            color: #ffffff;
        }
        .footer a {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            line-height: 32px;
            transition: 0.3s;
        }
        .footer a:hover {
            color: #ffffff;
            padding-left: 5px;
        }
        .copyright {
            background: #00091d;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Topbar Start -->
        <div class="container-fluid topbar px-5 d-none d-lg-block">
            <div class="row gx-0 align-items-center">
                <div class="col-lg-8 text-center text-lg-start">
                    <div class="d-inline-flex align-items-center">
                        <a class="btn-square" href="#"><i class="fab fa-twitter"></i></a>
                        <a class="btn-square" href="#"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn-square" href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a class="btn-square" href="#"><i class="fab fa-instagram"></i></a>
                        <a class="btn-square" href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 text-center text-lg-end topbar-right">
                    <a href="registration.aspx"><i class="fa fa-user me-1"></i> Register</a>
                    <a href="login.aspx"><i class="fa fa-sign-in-alt me-1"></i> Login</a>
                    <a href="#"><i class="fa fa-home me-1"></i> My Dashboard <i class="fa fa-caret-down ms-1"></i></a>
                </div>
            </div>
        </div>
        <!-- Topbar End -->

        <!-- Navbar Start -->
        <nav class="navbar navbar-expand-lg navbar-travela sticky-top">
            <a href="Home.aspx" class="navbar-brand">
                <h1><i class="fa fa-map-marker-alt me-2"></i>Travela</h1>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0 align-items-center">
                    <a href="Home.aspx" class="nav-item nav-link">Home</a>
                    <a href="About.aspx" class="nav-item nav-link">About</a>
                    <a href="Services.aspx" class="nav-item nav-link">Services</a>
                    <a href="Packages.aspx" class="nav-item nav-link">Packages</a>
                    <a href="Blog.aspx" class="nav-item nav-link">Blog</a>
                    
                    <!-- Pages Dropdown Menu -->
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Pages</a>
                        <div class="dropdown-menu m-0">
                            <a href="Destination.aspx" class="dropdown-item">Destination</a>
                            <a href="ExploreTour.aspx" class="dropdown-item">Explore Tour</a>
                            <a href="Booking.aspx" class="dropdown-item">Travel Booking</a>
                            <a href="Gallery.aspx" class="dropdown-item">Our Gallery</a>
                            <a href="Guides.aspx" class="dropdown-item">Travel Guides</a>
                            <a href="Testimonial.aspx" class="dropdown-item">Testimonial</a>
                            <a href="404.aspx" class="dropdown-item">404 Page</a>
                        </div>
                    </div>

                    <a href="Contact.aspx" class="nav-item nav-link">Contact</a>
                </div>
                <a href="Booking.aspx" class="btn btn-book-now ms-lg-3">Book Now</a>
            </div>
        </nav>
        <!-- Navbar End -->

        <!-- Main Body Content -->
        <div class="container-fluid py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Footer Start -->
        <div class="container-fluid footer py-5">
            <div class="container py-5">
                <div class="row g-5">
                    <div class="col-md-6 col-lg-4">
                        <h3 class="mb-3"><i class="fa fa-map-marker-alt me-2"></i>Travela</h3>
                        <p>Explore the world with Travela. Find the best travel packages, flight bookings, hotel reservations, and unforgettable tour experiences.</p>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <h4 class="mb-4">Quick Links</h4>
                        <a href="About.aspx"><i class="fas fa-angle-right me-2"></i> About Us</a><br>
                        <a href="Services.aspx"><i class="fas fa-angle-right me-2"></i> Our Services</a><br>
                        <a href="Packages.aspx"><i class="fas fa-angle-right me-2"></i> Travel Packages</a><br>
                        <a href="Contact.aspx"><i class="fas fa-angle-right me-2"></i> Contact Us</a>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <h4 class="mb-4">Contact Info</h4>
                        <p><i class="fa fa-map-marker-alt me-2"></i> 123 Street, New York, USA</p>
                        <p><i class="fa fa-envelope me-2"></i> info@example.com</p>
                        <p><i class="fa fa-phone-alt me-2"></i> +012 345 67890</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->

        <!-- Copyright Start -->
        <div class="container-fluid copyright py-3 text-center">
            <div class="container">
                <p class="m-0 text-white-50">&copy; <%: DateTime.Now.Year %> Travela, All rights reserved.</p>
            </div>
        </div>
        <!-- Copyright End -->

    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>